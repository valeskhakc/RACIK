{
  "ServiceName": "racik",
  "SourceConfiguration": {
    "AutoDeploymentsEnabled": false,
    "ImageRepository": {
      "ImageIdentifier": "ACCOUNT_ID.dkr.ecr.REGION.amazonaws.com/racik:latest",
      "ImageRepositoryType": "ECR",
      "ImageConfiguration": {
        "Port": "8000",
        "RuntimeEnvironmentVariables": {
          "RACIK_LLM_PROVIDER": "bedrock",
          "BEDROCK_MODEL_ID": "REPLACE_WITH_A_MODEL_ID_ENABLED_IN_YOUR_ACCOUNT",
          "AWS_REGION": "REGION"
        }
      }
    },
    "AuthenticationConfiguration": {
      "AccessRoleArn": "arn:aws:iam::ACCOUNT_ID:role/racik-apprunner-ecr-access"
    }
  },
  "InstanceConfiguration": {
    "Cpu": "1 vCPU",
    "Memory": "2 GB",
    "InstanceRoleArn": "arn:aws:iam::ACCOUNT_ID:role/racik-apprunner-bedrock-invoke"
  },
  "HealthCheckConfiguration": {
    "Protocol": "HTTP",
    "Path": "/api/health",
    "Interval": 10,
    "Timeout": 5,
    "HealthyThreshold": 1,
    "UnhealthyThreshold": 5
  }
}
