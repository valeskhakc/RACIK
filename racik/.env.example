# Copy to `.env` (gitignored) in this directory. Loaded automatically by
# racik/config.py on startup — no manual `export` needed. Without any of
# these, Agen Gizi/Agen Biaya and the /api/ask orchestrator all fall back to
# a deterministic, non-LLM path, so the app is fully demoable with nothing
# configured at all.
#
# Pick ONE provider block below and set RACIK_LLM_PROVIDER to match. See
# racik/README.md's "Choosing an LLM provider" section for details on each.

# RACIK_LLM_PROVIDER=openai
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# RACIK_LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# RACIK_LLM_PROVIDER=bedrock
# BEDROCK_MODEL_ID=
# AWS_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=          # only if using temporary/STS credentials

# RACIK_LLM_PROVIDER=sealion
# SEALION_API_KEY=
